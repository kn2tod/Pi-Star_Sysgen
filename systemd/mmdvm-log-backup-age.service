[Unit]
Description=Backup MMDVM log files
After=mmdvmhost.service
 
StartLimitBurst=3
 
[Service]
Type=simple
ExecCondition=/bin/sh -c 'test -x /usr/local/sbin/pistar-mmdvm-log-backup-age'
ExecStart=/usr/local/sbin/pistar-mmdvm-log-backup-age
 
Restart=on-failure
RestartSec=5s
 
[Install]
WantedBy=multi-user.target
